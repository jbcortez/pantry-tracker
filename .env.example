# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.
# Leave blank to run in device-only mode (no login, no sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Phase 3 recipes (server-side only — never prefix with VITE_). On Vercel, add it as an environment variable.
ANTHROPIC_API_KEY=
